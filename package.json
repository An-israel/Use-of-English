{
  "name": "jhts",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "samples:delete": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/db/delete-samples.sql",
    "db:test": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -o /dev/null -f supabase/tests/rls_smoke.sql",
    "screenshots": "node scripts/screenshots.mjs",
    "admin:create": "tsx scripts/create-super-admin.ts",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "db:rollback-test": "scripts/test-rollbacks.sh",
    "db:restore-drill": "scripts/restore-test.sh"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@react-email/render": "^2.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/otel": "^2.2.0",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "motion": "^14.8.0",
    "next": "16.4.3",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-pdf": "^10.5.0",
    "resend": "^6.35.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
