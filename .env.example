# Copy to .env.local for development. Never commit real values.
# With no Supabase values the public site runs in demo mode from the seed content.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). Region: London (eu-west-2).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
DATABASE_URL=                       # pooled (Supavisor) connection string, for scripts

# Paystack (test keys start with pk_test_/sk_test_; the admin shows TEST MODE)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Spam protection (Cloudflare Turnstile, free)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cron and metrics
CRON_SECRET=                        # 16+ random characters; Vercel Cron sends it
METRICS_SALT=                       # 16+ random characters; salts hashed session ids

# Error tracking (Sentry free tier; optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Alerts and on-call
ALERT_EMAIL=

# First Super Admin (npm run admin:create)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=

LOG_LEVEL=info
